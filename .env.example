# ── Google Ads Campaign Tracking ──────────────────────────────────────────────
# Ganti nilai di bawah dengan ID asli dari: Google Ads → Tools → Conversions
NEXT_PUBLIC_GOOGLE_ADS_ID="AW-10835470606"

# Ganti dengan label konversi asli dari: Google Ads → Tools → Conversions
# ⚠️ JANGAN pakai "WA_Click_Conversion_Label_XYZ" (itu placeholder contoh).
#    Label asli berformat alfanumerik pendek, misal: "abcdefghijklmnopqrst"
#    Jika masih kosong/placeholder, konversi Ads TIDAK tercatat.
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=""

# ── Google Ads — Konversi Klik Sosial Media ─────────────────────────────────
# Label konversi untuk klik ke akun Instagram/TikTok/YouTube.
# Ambil dari: Google Ads → Tools → Conversions → klik "Instagram"/"Tiktok" → Tag setup
# Kosongkan jika belum ada — tracking tetap jalan di GA4 (event social_click).
NEXT_PUBLIC_GOOGLE_ADS_INSTAGRAM_LABEL=""
NEXT_PUBLIC_GOOGLE_ADS_TIKTOK_LABEL=""
NEXT_PUBLIC_GOOGLE_ADS_YOUTUBE_LABEL=""

# ── Google Analytics 4 (GA4) ─────────────────────────────────────────────────
# Ambil dari: GA4 → Admin → Data Streams → Web → Measurement Protocol API secrets
# (atau lihat ID stream yang tampil sebagai G-XXXXXXXXXX)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID="G-67D0FX5RR7"

# ── Google Search Console Domain Verification ─────────────────────────────────
# Ambil dari: GSC → Settings → Ownership Verification → HTML tag → content attr
NEXT_PUBLIC_GSC_VERIFICATION_TAG="google-site-verification=NMUnW3W72_FhGAopoB_A3CVKRKvj1ouSQmjdjKc-d_Y"

# ── Business WhatsApp Number ──────────────────────────────────────────────────
# Format internasional tanpa +, contoh: 6281388497651 untuk +62 813-8849-7651
NEXT_PUBLIC_WHATSAPP_NUMBER="6281388497651"