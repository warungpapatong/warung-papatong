{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,

    /* Medium Strict */
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "strictNullChecks": true,

    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "postcss.config.cjs",
    "src/types/global.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.css" // <--- WAJIB TAMBAHKAN INI AGAR FILE CSS DI-SCAN
  ],
  "exclude": [
    "node_modules",
    ".next",
    "out",
    "dist"
  ]
}